# Airia configuration
AIRIA_API_KEY=ak-YOUR_API_KEY_HERE
AIRIA_PIPELINE_ID=YOUR_PIPELINE_UUID
AIRIA_IMPROVEMENT_PIPELINE_ID=YOUR_IMPROVEMENT_PIPELINE_UUID

# Modulate AI (Velma) configuration
# Discover the actual endpoint by inspecting DevTools Network tab on https://preview.modulate.ai/upload.html
MODULATE_UPLOAD_ENDPOINT=https://preview.modulate.ai/api/upload

# Lightdash configuration
LIGHTDASH_API_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
LIGHTDASH_INSTANCE_URL=https://app.lightdash.cloud
LIGHTDASH_PROJECT_UUID=YOUR_PROJECT_UUID
LIGHTDASH_EMBED_SECRET=YOUR_EMBED_SECRET
